{
  "rewrites": [
    {
      "source": "/home",
      "destination": "/home.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/apply",
      "destination": "/apply.html"
    },
    {
      "source": "/reset-password",
      "destination": "/auth/reset-password.html"
    },
    {
      "source": "/auth/reset-password",
      "destination": "/auth/reset-password.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/legal",
      "destination": "/legal.html"
    },
    {
      "source": "/support",
      "destination": "/support.html"
    },
    {
      "source": "/en/privacy",
      "destination": "/en/privacy.html"
    },
    {
      "source": "/en/terms",
      "destination": "/en/terms.html"
    },
    {
      "source": "/en/legal",
      "destination": "/en/legal.html"
    },
    {
      "source": "/en/support",
      "destination": "/en/support.html"
    },
    {
      "source": "/delete-account",
      "destination": "/delete-account.html"
    },
    {
      "source": "/en/delete-account",
      "destination": "/en/delete-account.html"
    },
    {
      "source": "/m/:code",
      "destination": "/m.html"
    },
    {
      "source": "/g/:code",
      "destination": "/g.html"
    },
    {
      "source": "/f/:code",
      "destination": "/f.html"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "source": "/g/:code",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/m/:code",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/f/:code",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ]
}
